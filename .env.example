# Database (Neon PostgreSQL or Local Docker)
DATABASE_URL="postgresql://worksphere:worksphere@localhost:5432/worksphere"

# Redis (Upstash Redis or Local Docker Proxy)
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN=""

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# AI (Groq)
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_api_key"

# Admin Configuration
ADMIN_EMAILS="admin@worksphere.com,your-email@example.com"

# ==============================================================================
# Webhook Signing Secrets & Event Handling (Optional for basic local dev)
# ==============================================================================
# Webhooks handle asynchronous events (user lifecycle sync, billing, reservations).
# Required ONLY if testing webhook endpoints locally. Omit for basic frontend dev.
#
# --- 1. Clerk Authentication Webhooks (Svix) ---
# Used by /api/webhook for user creation, update, and deletion events.
# Get secret from Clerk Dashboard > Webhooks > Endpoint Signing Secret
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_signing_secret"
WEBHOOK_SECRET="whsec_your_clerk_webhook_secret" # Legacy fallback key
SVIX_TOKEN="your_svix_api_token"

# Local Clerk Webhook Forwarding CLI Command:
#   npx svix listen http://localhost:3000/api/webhook

# --- 2. Stripe Payments & Billing Webhooks ---
# Used by /api/webhooks/stripe for subscription and payment confirmation events.
# Get secret from Stripe Dashboard > Developers > Webhooks > Signing Secret
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Local Stripe Webhook Forwarding CLI Command:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe

# --- 3. Internal Worker & Microservice Secrets ---
WORKER_SECRET="your_internal_worker_secret"

# ZKP / Venue Access Tokens (minimum 32 characters)
ENCRYPTION_KEY="your-32-character-minimum-encryption-key"

# ZKP Membership (comma-separated commitment values; omit for demo defaults)
PREMIUM_MEMBER_COMMITS="commit1,commit2,commit3"

# =========================
# Solana Pay fee sponsorship
# =========================
# Server-only relayer settings. Never expose the private key to the browser.
# SOLANA_RPC_URL="https://api.devnet.solana.com"
# SOLANA_RELAYER_PRIVATE_KEY="[1,2,3,...64 bytes...]"
# Keep this ceiling low to limit relayer exposure to unexpected transaction fees.
# SOLANA_MAX_RELAY_FEE_LAMPORTS="10000"

# ========================
# Web Push Notifications (Optional)
# ========================

# VAPID public key — exposed to the browser for push subscription registration
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# VAPID private key — server-side only; never expose to the browser
# VAPID_PRIVATE_KEY="your-vapid-private-key"

# VAPID subject — typically "mailto:admin@yourdomain.com" or your app URL
# VAPID_SUBJECT="mailto:admin@example.com"

# Generate a VAPID key pair:
#   npx web-push generate-vapid-keys

# ==========================================
# WhatsApp & SMS Notifications (Optional)
# ==========================================
# WorkSphere supports two WhatsApp notification providers: Twilio or Meta Cloud API.
# Configure either provider below to enable automated booking confirmation messages.

# --- Option A: Twilio WhatsApp Provider (Recommended for local dev) ---
# Setup guide: https://www.twilio.com/docs/whatsapp/sandbox
# TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Option B: Meta Cloud API WhatsApp Provider ---
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# WHATSAPP_API_TOKEN="EAAG_your_meta_system_user_access_token"
# WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
