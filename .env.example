# ==============================================================================
# PostgreSQL — MANDATORY for local development and cloud deployment
# ==============================================================================
# Local Docker Compose runs Postgres on localhost:5432 (service `postgres` in
# docker-compose.yml). Start it with `docker compose up -d postgres redis` —
# full walkthrough: docs/guides/LOCAL_DEVELOPMENT_SETUP.md.
#
# Expected format (connection string schema):
#   postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Local Docker default:  postgresql://worksphere:worksphere@localhost:5432/worksphere
# Read by src/lib/prisma.ts. Fallback when unset (dev only):
#   postgresql://dummy:dummy@localhost:5432/dummy — queries fail without a real URL.
DATABASE_URL="postgresql://worksphere:worksphere@localhost:5432/worksphere"

# --- DIRECT_URL — OPTIONAL for local development (recommended) ---------------
# Direct (unpooled) Postgres connection string used by partition management and
# retention jobs (src/lib/database/partitionManager.ts and
# src/lib/partitionRetention.ts). Fallback when unset: DATABASE_URL, so plain
# local Docker dev works without it.
# Expected format: same as DATABASE_URL (local Docker default: localhost:5432).
# For pooled cloud databases (e.g. Neon pooler) point DATABASE_URL at the
# pooled endpoint and DIRECT_URL at the unpooled endpoint.
DIRECT_URL="postgresql://worksphere:worksphere@localhost:5432/worksphere"

# ==============================================================================
# Redis — OPTIONAL for local development (in-memory fallback when unset)
# ==============================================================================
# Local Docker Compose runs Redis on localhost:6379 (service `redis` in
# docker-compose.yml). Docker setup: docs/guides/LOCAL_DEVELOPMENT_SETUP.md.
#
# --- REDIS_URL — TCP Redis connection (recommended for local Docker) ----------
# Expected format: redis://<host>:<port>
# Local Docker default: redis://localhost:6379
# Preferred by the reservation CDC worker (src/workers/reservationCdcWorker.ts,
# src/lib/database/cdcStreamer.ts) and keyspace-notification subscribers
# (src/lib/redis/keyspaceNotifications.ts,
# src/lib/reservations/redisKeyspaceSubscriber.ts) for sub-15ms WAL -> stream
# latency; requires the optional `ioredis` package (already in package.json).
# Fallback when unset: REDIS_TCP_URL, otherwise the REST transport below or the
# timer-wheel fallback — the app still starts. Mandatory only when running the
# CDC worker (`npm run cdc:worker`) or live keyspace subscriptions.
REDIS_URL="redis://localhost:6379"

# --- UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — REST API (optional) --
# Upstash-compatible REST endpoint used by rate limiting, caching and analytics
# (src/lib/rateLimit.ts, src/lib/redis.ts, src/lib/analytics.ts).
# Fallback when both are unset: in-memory rate limiter / cache — local
# development still starts (see docs/ENV_VARS.md).
# Mandatory: no for local development; for cloud deployment set the real
# endpoint and token from the Upstash console:
#   UPSTASH_REDIS_REST_URL="https://<db>.upstash.io"
#   UPSTASH_REDIS_REST_TOKEN="<your-upstash-token>"
# `http://localhost:8079` below points at a local REST proxy (as shown in
# README.md) — leave both empty/unused if you do not run one.
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN=""

# --- Reservation CDC worker (src/workers/reservationCdcWorker.ts) ------------
# CDC_DATABASE_URL is a second Postgres connection string for the change-data-
# capture worker only; local default matches DATABASE_URL (localhost:5432).
# Optional: required solely for `npm run cdc:worker`.
CDC_DATABASE_URL="postgresql://worksphere:worksphere@localhost:5432/worksphere"
CDC_REPLICATION_SLOT="worksphere_cdc_slot"
CDC_PLUGIN="test_decoding"
CDC_PUBLICATION="worksphere_cdc_pub"
CDC_SCHEMA="public"
CDC_STREAM_KEY="stream:db:changes"
# CDC_TABLES="Booking,DeskLock,VenueTelemetry"
# CDC_LSN_STATE_FILE=".cdc-state/worksphere_cdc_slot.lsn.json"
# CDC_REDIS_TRANSPORT="rest"
# CDC_STREAM_MAX_LENGTH="100000"
# CDC_LOG_LEVEL="info"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# AI (Groq)
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_api_key"

# Admin Configuration
ADMIN_EMAILS="admin@worksphere.com,your-email@example.com"

# ==============================================================================
# Webhook Signing Secrets & Event Handling (Optional for basic local dev)
# ==============================================================================
# Webhooks handle asynchronous events (user lifecycle sync, billing, reservations).
# Required ONLY if testing webhook endpoints locally. Omit for basic frontend dev.
#
# --- 1. Clerk Authentication Webhooks (Svix) ---
# Used by /api/webhook for user creation, update, and deletion events.
# Get secret from Clerk Dashboard > Webhooks > Endpoint Signing Secret
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_signing_secret"
WEBHOOK_SECRET="whsec_your_clerk_webhook_secret" # Legacy fallback key
SVIX_TOKEN="your_svix_api_token"

# Local Clerk Webhook Forwarding CLI Command:
#   npx svix listen http://localhost:3000/api/webhook

# --- 2. Stripe Payments & Billing Webhooks ---
# Used by /api/webhooks/stripe for subscription and payment confirmation events.
# Get secret from Stripe Dashboard > Developers > Webhooks > Signing Secret
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Local Stripe Webhook Forwarding CLI Command:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe

# --- 3. Internal Worker & Microservice Secrets ---
WORKER_SECRET="your_internal_worker_secret"

# ZKP / Venue Access Tokens (minimum 32 characters)
ENCRYPTION_KEY="your-32-character-minimum-encryption-key"

# ZKP Membership (comma-separated commitment values; omit for demo defaults)
PREMIUM_MEMBER_COMMITS="commit1,commit2,commit3"

# Anonymous venue-access Merkle roots accepted by POST /api/zkp/membership/verify.
# Entries are `root` or `root:epoch` (decimal field elements), separated by commas
# or semicolons. Each epoch is a unix-second membership period start.
#   - configured entries  → only those roots/epochs are accepted
#   - unset in production → every proof is rejected (fail-closed)
#   - unset elsewhere     → any well-formed root is accepted (local demos/tests)
MEMBERSHIP_MERKLE_ROOTS=""

# =========================
# Solana Pay fee sponsorship
# =========================
# Server-only relayer settings. Never expose the private key to the browser.
# SOLANA_RPC_URL="https://api.devnet.solana.com"
# SOLANA_RELAYER_PRIVATE_KEY="[1,2,3,...64 bytes...]"
# Keep this ceiling low to limit relayer exposure to unexpected transaction fees.
# SOLANA_MAX_RELAY_FEE_LAMPORTS="10000"

# =====================================================
# Solana escrow RPC failover cluster (optional)
# =====================================================
# Redundant RPC nodes used by the escrow client pool. On HTTP 429/503 or
# connection timeouts (>4s) requests automatically rotate to the next endpoint.
# Comma/space separated; first healthy endpoint becomes the active node.
# Falls back to https://api.devnet.solana.com when unset.
# NEXT_PUBLIC_SOLANA_RPC_URLS="https://api.devnet.solana.com https://solana-devnet.genesysgo.net"
# Server-only equivalent (client pool reads the NEXT_PUBLIC_ value first).
# SOLANA_RPC_URLS="https://api.devnet.solana.com https://api.testnet.solana.com"

# ==========================================================
# Automated Solana escrow refunds (/api/cron/escrow-refund)
# ==========================================================
# Deployed worksphere_escrow program ID; refunds are disabled while unset.
# NEXT_PUBLIC_ESCROW_PROGRAM_ID="your-escrow-program-id"
# Cluster authority keypair that signs refund transactions. Accepts either the
# base58 secret key or the JSON 64-byte array printed by `solana-keygen`.
# Server-only; never expose it to the browser.
# SOLANA_ESCROW_AUTHORITY_SECRET_KEY="[1,2,3,...64 bytes...]"
# Optional cron tuning (defaults: 30s confirmation timeout, 2s poll, 10min stale).
# ESCROW_REFUND_CONFIRMATION_TIMEOUT_MS="30000"
# ESCROW_REFUND_POLL_INTERVAL_MS="2000"
# ESCROW_REFUND_STALE_CLAIM_MS="600000"

# ========================
# Web Push Notifications (Optional)
# ========================

# VAPID public key — exposed to the browser for push subscription registration
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# VAPID private key — server-side only; never expose to the browser
# VAPID_PRIVATE_KEY="your-vapid-private-key"

# VAPID subject — typically "mailto:admin@yourdomain.com" or your app URL
# VAPID_SUBJECT="mailto:admin@example.com"

# Generate a VAPID key pair:
#   npx web-push generate-vapid-keys

# ==========================================
# WhatsApp & SMS Notifications (Optional)
# ==========================================
# WorkSphere supports two WhatsApp notification providers: Twilio or Meta Cloud API.
# Configure either provider below to enable automated booking confirmation messages.

# --- Option A: Twilio WhatsApp Provider (Recommended for local dev) ---
# Setup guide: https://www.twilio.com/docs/whatsapp/sandbox
# TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Option B: Meta Cloud API WhatsApp Provider ---
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# WHATSAPP_API_TOKEN="EAAG_your_meta_system_user_access_token"
# WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"

# ==============================================================================
# Interactive Maps & Spatial Tiles (Optional)
# ==============================================================================
# Public Mapbox token for vector map styles. When omitted, WorkSphere automatically
# and gracefully falls back to public OpenStreetMap and CartoCDN raster tile servers.
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_public_token"

