#version 310 es
// Calculates edge-density and color-entropy metrics to quantify visual desk clutter.

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8) uniform readonly image2D u_Frame;
layout(r32f) uniform writeonly image2D u_ClutterMap;

uniform float u_EdgeThreshold;

float getLuminance(ivec2 pos) {
    vec4 color = imageLoad(u_Frame, pos);
    return dot(color.rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Frame);
    
    if (pos.x >= size.x - 1 || pos.y >= size.y - 1) return;

    // Sobel operator for edge detection
    float l = getLuminance(pos - ivec2(1, 0));
    float r = getLuminance(pos + ivec2(1, 0));
    float t = getLuminance(pos - ivec2(0, 1));
    float b = getLuminance(pos + ivec2(0, 1));
    
    float gx = r - l;
    float gy = b - t;
    float edgeMagnitude = sqrt(gx * gx + gy * gy);
    
    float clutterScore = edgeMagnitude > u_EdgeThreshold ? 1.0 : 0.0;
    
    imageStore(u_ClutterMap, pos, vec4(clutterScore, 0.0, 0.0, 1.0));
}
